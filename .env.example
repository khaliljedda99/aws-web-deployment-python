# AWS region where the infrastructure will be deployed (Virginia).
AWS_REGION=us-east-1

# Optional SSH source IPv4 CIDR. Leave blank to detect your current public IP (/32).
MY_IP_CIDR=

# Prefix used to name the AWS resources created by the deployment.
STACK_NAME=Hosting

# Local path where the EC2 private key is saved on first deployment.
KEY_PAIR_FILE=Hosting-KeyPair.pem
